---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { LOCALES, DEFAULT_LOCALE, HTML_LANG, OG_LOCALE, t } from '../i18n/ui.js';
import { getSettings, link, typeAttrs } from '../lib/content.js';

const { lang, title, description, path = '/', image, noindex = false, jsonld, app = false } = Astro.props;
const settings = getSettings(lang);
const site = Astro.site;
const abs = (p) => new URL(p, site).href;
const canonical = abs(`/${lang}${path}`);
const desc = description || settings.seo_description || '';
const fullTitle = title ? (title.includes(settings.brand_name) ? title : `${title} | ${settings.brand_name}`) : settings.brand_name;
const ogImage = image || settings.og_image;
const { type, kase, style } = typeAttrs(settings);
---
<!doctype html>
<html lang={HTML_LANG[lang]} data-type={type} data-case={kase} style={style}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  {desc && <meta name="description" content={desc} />}
  <link rel="canonical" href={canonical} />
  {LOCALES.map((l) => <link rel="alternate" hreflang={HTML_LANG[l]} href={abs(`/${l}${path}`)} />)}
  <link rel="alternate" hreflang="x-default" href={abs(`/${DEFAULT_LOCALE === 'es' ? 'en' : DEFAULT_LOCALE}${path}`)} />
  {noindex && <meta name="robots" content="noindex" />}
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={settings.brand_name} />
  <meta property="og:title" content={fullTitle} />
  {desc && <meta property="og:description" content={desc} />}
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content={OG_LOCALE[lang]} />
  {ogImage && <meta property="og:image" content={abs(ogImage)} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#222624" />
  <link rel="icon" href={settings.favicon ? '/favicon-auto.svg' : '/favicon.svg'} type="image/svg+xml" />
  <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
  <link rel="icon" href="/favicon-192.png" sizes="192x192" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
  <slot name="head" />
</head>
<body class={app ? 'is-app' : undefined}>
  {app ? (
    <main id="main"><slot /></main>
  ) : (
    <>
      <a class="skip" href="#main">{t(lang, 'skip')}</a>
      {settings.announcement && (
        <div class="announce">
          <div class="wrap">
            {settings.announcement_link ? <a href={link(settings.announcement_link, lang)}>{settings.announcement}</a> : <p class="announce__text">{settings.announcement}</p>}
          </div>
        </div>
      )}
      <Header lang={lang} path={path} settings={settings} />
      <main id="main">
        <slot />
      </main>
      <Footer lang={lang} path={path} settings={settings} />
    </>
  )}
</body>
</html>
