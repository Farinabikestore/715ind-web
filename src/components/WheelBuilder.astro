---
// Armador de ruedas 715IND (mismo armador de farinabikestore.com/arma-tu-rueda, en modo catálogo).
// - Muestra todos los productos, sin precios ni stock.
// - Visor 3D: copia local de github.com/Farinabikestore/715-3d (carpeta public/3d).
// - "Comprar" lleva al armador de Fariña Bike Store; "Solicitar cotización" abre el formulario con la configuración.
// Los datos (llantas, mazas, núcleos, largos de rayo) se editan en el panel: Armador de ruedas.
import { t, clientStrings, LOCALES, LANG_NAMES } from '../i18n/ui.js';
import { getBuilder, getSettings } from '../lib/content.js';
import { variant } from '../lib/img.js';

const { lang } = Astro.props;
const data = getBuilder();
const settings = getSettings(lang);
const nav = [['/products/', 'nav.products'], ['/about/', 'nav.about'], ['/contact/', 'nav.contact']];
const colorName = (c) => {
  const k = `color.${c.id}`;
  const v = t(lang, k);
  return v === k ? c.name : v;
};
const mapColors = (list = []) => list.map((c) => ({ id: c.id, name: colorName(c), img: c.image ? variant(c.image, 480) : '' }));
const payload = {
  sizes: (data.sizes || []).map(String),
  rims: (data.rims || []).map((r) => ({ id: r.id, name: r.name, note: r.note || '', sizes: (r.sizes || data.sizes || []).map(String), holes: r.holes || [], colors: mapColors(r.colors) })),
  front: (data.front_hubs || []).map((h) => ({ id: h.id, name: h.name, note: h.note || '', holes: h.holes || [], colors: mapColors(h.colors) })),
  rear: (data.rear_hubs || []).map((h) => ({ id: h.id, name: h.name, note: h.note || '', holes: h.holes || [], freehubs: h.freehubs || [], colors: mapColors(h.colors) })),
  freehubs: (data.freehubs || []).map((f) => ({ id: f.id, name: f.name })),
  spoke: data.spoke || '',
  nipple: data.nipple || '',
  lengths: (data.spoke_lengths || []).map((l) => ({ rim: l.rim, size: String(l.size), hub: l.hub, holes: Number(l.holes), left: Number(l.left), right: Number(l.right) })),
  strings: clientStrings(lang, ['builder.']),
  shop: 'https://www.farinabikestore.com/arma-tu-rueda',
  contact: `/${lang}/contact/?from=builder`,
};
---
<div id="arm-app" class="arm-app" data-armador>
  <div class="arm-vis">
    <a class="arm-mark" href={`/${lang}/`} aria-label={settings.brand_name}>
      {settings.logo ? <img src={settings.logo} alt="" /> : settings.brand_name}
    </a>
    <div class="arm-wt" id="arm-wt">
      <button type="button" data-w="d">{t(lang, 'builder.type.front')}</button><button type="button" data-w="t" class="sel">{t(lang, 'builder.type.rear')}</button>
    </div>
    <div id="arm-3d" role="img" aria-label={t(lang, 'builder.preview')}></div>
  </div>
  <aside class="arm-panel">
    <div class="arm-head">
      <h1 class="arm-title">{t(lang, 'builder.title')}</h1>
      <details class="arm-menu">
        <summary>{t(lang, 'nav.menu')}</summary>
        <nav>
          <a href={`/${lang}/`}>{settings.brand_name}</a>
          {nav.map(([href, key]) => <a href={`/${lang}${href}`}>{t(lang, key)}</a>)}
          <span class="arm-langs">{LOCALES.map((l) => <a href={`/${l}/wheel-builder/`} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined}>{l.toUpperCase()}</a>)}</span>
        </nav>
      </details>
    </div>
    <div class="arm-scroll" id="arm-scroll">
      <p class="arm-sub">{t(lang, 'builder.intro')}</p>
      <div id="arm-loading" class="arm-loading">{t(lang, 'builder.loading')}</div>
      <div id="arm-grid" hidden>
        <div id="arm-steps"></div>
        <div class="arm-side" id="builder-summary">
          <h2>{t(lang, 'builder.summary')}</h2>
          <div id="arm-summary" aria-live="polite"></div>
          <p class="arm-note">{t(lang, 'builder.buyNote')}</p>
        </div>
      </div>
    </div>
    <div class="arm-bar">
      <a id="arm-buy" class="arm-btn" href={payload.shop} target="_blank" rel="noopener">{t(lang, 'builder.buy')} ↗</a>
      <button type="button" id="arm-quote" class="arm-link">{t(lang, 'builder.request')}</button>
      <div id="arm-msg" class="arm-msg" role="status"></div>
    </div>
  </aside>
</div>
<script type="application/json" id="arm-data" set:html={JSON.stringify(payload).replace(/</g, '\\u003c')} />

<script>
  type Color = { id: string; name: string; img: string };
  type Part = { id: string; name: string; note: string; holes: number[]; sizes?: string[]; freehubs?: string[]; colors: Color[] };
  type Wheel = { size: string | null; rim: string | null; holes: number | null; hub: string | null; fh: string | null };

  const root = document.querySelector<HTMLElement>('[data-armador]');
  const raw = document.getElementById('arm-data');
  if (root && raw) {
    const D = JSON.parse(raw.textContent || '{}');
    const S = (k: string) => D.strings[k] || k;
    const esc = (v: unknown) => String(v ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] as string);
    const rims: Part[] = D.rims, front: Part[] = D.front, rear: Part[] = D.rear;
    const fhName = (id: string) => (D.freehubs.find((f: { id: string }) => f.id === id) || { name: id }).name;

    // ---- Estado: una rueda (delantera o trasera) o un juego (par) ----
    const blank = (): Wheel => ({ size: null, rim: null, holes: null, hub: null, fh: null });
    const sel = { tipo: 'tra' as 'del' | 'tra' | 'par', one: blank(), par: { d: blank(), t: blank() } };
    const q = new URLSearchParams(location.search).get('tipo') || '';
    if (/^del|^front/i.test(q)) sel.tipo = 'del';
    else if (/^(par|jue|set|pair)/i.test(q)) sel.tipo = 'par';
    if (D.sizes.length === 1) { sel.one.size = D.sizes[0]; sel.par.d.size = D.sizes[0]; sel.par.t.size = D.sizes[0]; }

    // Claves "pieza|color"
    const split = (k: string | null) => (k ? k.split('|') : [null, null]) as [string | null, string | null];
    const findPart = (list: Part[], k: string | null) => { const [id, c] = split(k); const p = list.find((x) => x.id === id); return p ? { p, c: p.colors.find((x) => x.id === c) || p.colors[0] } : null; };
    const hubsFor = (pos: 'd' | 't') => (pos === 'd' ? front : rear);
    const frontHoles = () => [...new Set(front.flatMap((h) => h.holes))];
    const posOf = (w: 'one' | 'd' | 't'): 'd' | 't' => (w === 'one' ? (sel.tipo === 'del' ? 'd' : 't') : w);
    const W = (w: 'one' | 'd' | 't'): Wheel => (w === 'one' ? sel.one : sel.par[w]);
    const allowedHoles = (rim: Part, pos: 'd' | 't') => { const hub = new Set(hubsFor(pos).flatMap((h) => h.holes)); return rim.holes.filter((h) => hub.has(h)); };

    function lengthFor(st: Wheel, pos: 'd' | 't') {
      const r = findPart(rims, st.rim), h = findPart(hubsFor(pos), st.hub);
      if (!r || !h || !st.holes || !st.size) return null;
      return D.lengths.find((l: { rim: string; size: string; hub: string; holes: number }) => l.rim === r.p.id && l.size === st.size && l.hub === h.p.id && l.holes === st.holes) || null;
    }
    const lenText = (l: { left: number; right: number }) => (l.left === l.right ? `${l.left} mm` : `${l.left} / ${l.right} mm`);
    const sizeLabel = (s: string) => `${s}"`;

    // ---- Tarjetas ----
    function card(attrs: string, selected: boolean, img: string, name: string, note: string) {
      return `<button type="button" class="arm-card${selected ? ' sel' : ''}" ${attrs} aria-pressed="${selected}">`
        + (img ? `<span class="im"><img loading="lazy" src="${esc(img)}" alt=""></span>` : '')
        + `<span class="bd"><span class="nm">${esc(name)}</span>${note ? `<small>${esc(note)}</small>` : ''}</span></button>`;
    }
    function chips(attrs: string, items: { v: string | number; label: string; out?: boolean }[], current: unknown) {
      return '<div class="arm-vals">' + items.map((i) => {
        const on = String(current) === String(i.v);
        return `<button type="button" class="arm-val${on ? ' sel' : ''}${i.out ? ' out' : ''}" ${attrs} data-val="${esc(i.v)}"${i.out ? ' disabled' : ''} aria-pressed="${on}">${esc(i.label)}${i.out ? ` (${esc(S('builder.notCompatible'))})` : ''}</button>`;
      }).join('') + '</div>';
    }
    const empty = (txt: string) => `<div class="arm-empty">${esc(txt)}</div>`;

    // ---- Pasos de una rueda ----
    function wheelSteps(w: 'one' | 'd' | 't', head: (t: string, z?: string, zw?: string) => string) {
      const st = W(w), pos = posOf(w), zw = w === 'one' ? '' : w;
      const par = w !== 'one';
      let h = '';
      h += head(esc(par ? S(pos === 'd' ? 'builder.frontSize' : 'builder.rearSize') : S('builder.size')), 'full', zw)
        + '<div class="arm-sizes">' + D.sizes.map((s: string) => `<button type="button" class="arm-size${st.size === s ? ' sel' : ''}" data-w="${w}" data-size="${esc(s)}" aria-pressed="${st.size === s}">${esc(sizeLabel(s))}</button>`).join('') + '</div></div>';

      const rimTitle = esc(par ? S(pos === 'd' ? 'builder.frontRim' : 'builder.rearRim') : S('builder.rim'));
      if (!st.size) h += head(rimTitle, 'full', zw) + empty(S('builder.pickSizeFirst')) + '</div>';
      else {
        const list = rims.filter((r) => (r.sizes || []).includes(st.size as string));
        let body = list.length ? '<div class="arm-cards">' + list.flatMap((r) => r.colors.map((c) => card(`data-w="${w}" data-rim="${esc(r.id + '|' + c.id)}"`, st.rim === r.id + '|' + c.id, c.img, `${r.name} ${sizeLabel(st.size as string)} ${c.name}`, r.note))).join('') + '</div>' : empty(S('builder.empty'));
        const r = findPart(rims, st.rim);
        if (r) {
          const ok = allowedHoles(r.p, pos);
          body += chips(`data-w="${w}" data-holes`, r.p.holes.map((x) => ({ v: x, label: `${x}H`, out: !ok.includes(x) })), st.holes);
        }
        h += head(rimTitle + (par && pos === 't' ? ` <span class="hint">${esc(S('builder.pickHoles'))}</span>` : ''), 'full', zw) + body + '</div>';
      }

      const hubTitle = esc(S(pos === 'd' ? 'builder.frontHub' : 'builder.rearHub'));
      const hubs = hubsFor(pos).filter((x) => !st.holes || x.holes.includes(st.holes));
      h += head(hubTitle, 'maza', zw) + (hubs.length ? '<div class="arm-cards">' + hubs.flatMap((x) => x.colors.map((c) => card(`data-w="${w}" data-hub="${esc(x.id + '|' + c.id)}"`, st.hub === x.id + '|' + c.id, c.img, `${x.name} ${c.name}`, x.note))).join('') + '</div>' : empty(S('builder.empty'))) + '</div>';

      if (pos === 't') {
        const hb = findPart(rear, st.hub);
        h += head(esc(S('builder.freehub')), 'maza', zw) + (hb ? chips(`data-w="${w}" data-fh`, (hb.p.freehubs || []).map((f) => ({ v: f, label: fhName(f) })), st.fh) : empty(S('builder.pickRearHubFirst'))) + '</div>';
      }
      return h;
    }

    function spokesStep(head: (t: string) => string) {
      const parts = `${D.spoke}${D.nipple ? ' + ' + D.nipple : ''}`;
      if (sel.tipo === 'par') {
        const d = lengthFor(sel.par.d, 'd'), t = lengthFor(sel.par.t, 't');
        const ready = sel.par.d.hub && sel.par.t.hub;
        return head(S('builder.spokes')) + (ready ? `<div class="arm-info"><b>${esc(parts)}</b><small>${esc(S('builder.length'))} · ${esc(S('builder.type.front'))}: ${esc(d ? lenText(d) : S('builder.lengthsNA'))} · ${esc(S('builder.type.rear'))}: ${esc(t ? lenText(t) : S('builder.lengthsNA'))}</small></div>` : empty(S('builder.pickBothForSpokes'))) + '</div>';
      }
      const pos = posOf('one'), l = lengthFor(sel.one, pos);
      return head(S('builder.spokes')) + (sel.one.hub && sel.one.holes ? `<div class="arm-info"><b>${esc(parts)}</b><small>${esc(S('builder.length'))}: ${esc(l ? lenText(l) : S('builder.lengthsNA'))} · ${sel.one.holes} u.</small></div>` : empty(S('builder.pickForSpokes'))) + '</div>';
    }

    function render() {
      let n = 0;
      const head = (txt: string, z?: string, zw?: string) => { n++; return `<div class="arm-step" data-zk="s${n}"${z ? ` data-zone="${z}"` : ''}${zw ? ` data-zw="${zw}"` : ''}><h3><span class="n">${n}</span>${txt}</h3>`; };
      let h = head(esc(S('builder.type')), 'full') + '<div class="arm-toggle">'
        + (['del', 'tra', 'par'] as const).map((k) => `<button type="button" data-tipo="${k}" class="${sel.tipo === k ? 'sel' : ''}" aria-pressed="${sel.tipo === k}">${esc(S(k === 'del' ? 'builder.type.front' : k === 'tra' ? 'builder.type.rear' : 'builder.type.pair'))}</button>`).join('') + '</div></div>';
      if (sel.tipo === 'par') {
        h += `<div class="arm-wheel">${esc(S('builder.frontWheel'))}</div>` + wheelSteps('d', head);
        h += `<div class="arm-wheel">${esc(S('builder.rearWheel'))}</div>` + wheelSteps('t', head);
      } else {
        h += wheelSteps('one', head);
      }
      h += spokesStep((t) => head(esc(t)));
      document.getElementById('arm-steps')!.innerHTML = h;
      renderSummary();
      update3D();
    }

    // ---- Resumen ----
    function wheelLines(st: Wheel, pos: 'd' | 't') {
      const out: [string, string][] = [];
      if (st.size) out.push([S('builder.size'), sizeLabel(st.size)]);
      const r = findPart(rims, st.rim);
      if (r) out.push([S('builder.rim'), `${r.p.name} ${r.c ? r.c.name : ''}${st.holes ? ' · ' + st.holes + 'H' : ''}`]);
      const hb = findPart(hubsFor(pos), st.hub);
      if (hb) out.push([S(pos === 'd' ? 'builder.frontHub' : 'builder.rearHub'), `${hb.p.name} ${hb.c ? hb.c.name : ''}`]);
      if (pos === 't' && st.fh) out.push([S('builder.freehub'), fhName(st.fh)]);
      const l = lengthFor(st, pos);
      if (hb && st.holes) out.push([S('builder.spokes'), `${D.spoke}${l ? ' · ' + lenText(l) : ''}`]);
      return out;
    }
    const done = (st: Wheel, pos: 'd' | 't') => !!(st.size && st.rim && st.holes && st.hub && (pos === 'd' || st.fh));
    let configText = '';
    function renderSummary() {
      let html = '', lines: string[] = [], ok = false;
      const row = ([k, v]: [string, string]) => `<div class="arm-line"><span class="l">${esc(k)}</span><span class="v">${esc(v)}</span></div>`;
      if (sel.tipo === 'par') {
        const a = wheelLines(sel.par.d, 'd'), b = wheelLines(sel.par.t, 't');
        if (a.length) html += `<div class="arm-line sub"><span class="l">${esc(S('builder.type.front'))}</span></div>` + a.map(row).join('');
        if (b.length) html += `<div class="arm-line sub"><span class="l">${esc(S('builder.type.rear'))}</span></div>` + b.map(row).join('');
        lines = [`${S('builder.type')}: ${S('builder.type.pair')}`, `— ${S('builder.type.front')}`, ...a.map(([k, v]) => `${k}: ${v}`), `— ${S('builder.type.rear')}`, ...b.map(([k, v]) => `${k}: ${v}`)];
        ok = done(sel.par.d, 'd') && done(sel.par.t, 't');
      } else {
        const pos = posOf('one'), a = wheelLines(sel.one, pos);
        html += a.map(row).join('');
        lines = [`${S('builder.type')}: ${S(pos === 'd' ? 'builder.type.front' : 'builder.type.rear')}`, ...a.map(([k, v]) => `${k}: ${v}`)];
        ok = done(sel.one, pos);
      }
      document.getElementById('arm-summary')!.innerHTML = html || `<div class="arm-empty">${esc(S('builder.nothing'))}</div>`;
      configText = ok ? lines.join('\n') : '';
      const tipo = sel.tipo === 'del' ? 'delantera' : sel.tipo === 'tra' ? 'trasera' : 'par';
      (document.getElementById('arm-buy') as HTMLAnchorElement).href = `${D.shop}?tipo=${tipo}`;
      const qb = document.getElementById('arm-quote')!;
      qb.setAttribute('aria-disabled', String(!ok));
      if (ok) msg('');
    }
    function msg(txt: string) { const m = document.getElementById('arm-msg')!; m.textContent = txt; m.className = 'arm-msg' + (txt ? ' err' : ''); }

    // ---- Clics ----
    const resetBelow = (st: Wheel, from: 'size' | 'rim' | 'holes' | 'hub') => {
      if (from === 'size') { st.rim = null; st.holes = null; st.hub = null; st.fh = null; }
      if (from === 'rim') { st.holes = null; }
      if (from === 'rim' || from === 'holes') { const h = findPart(hubsFor('t'), st.hub) || findPart(hubsFor('d'), st.hub); if (h && st.holes && !h.p.holes.includes(st.holes)) { st.hub = null; st.fh = null; } }
      if (from === 'hub') { st.fh = null; }
    };
    root.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLElement>('button');
      if (!b || !root.contains(b)) return;
      if (b.id === 'arm-quote') return quote();
      if (b.dataset.tipo) {
        const t = b.dataset.tipo as typeof sel.tipo;
        if (t !== sel.tipo) { if (sel.tipo !== 'par' && t !== 'par') { sel.one.hub = null; sel.one.fh = null; if (sel.one.rim) { const r = findPart(rims, sel.one.rim); if (r && sel.one.holes && !allowedHoles(r.p, t === 'del' ? 'd' : 't').includes(sel.one.holes)) sel.one.holes = null; } } sel.tipo = t; rueda3D = 't'; }
        zoom3D('full'); return render();
      }
      const w = b.dataset.w as 'one' | 'd' | 't' | undefined;
      if (!w || (w !== 'one' && w !== 'd' && w !== 't')) return;
      const st = W(w), pos = posOf(w);
      if (w !== 'one') rueda3D = w;
      if (b.dataset.size) { st.size = b.dataset.size; resetBelow(st, 'size'); zoom3D('full'); }
      else if (b.dataset.rim) {
        st.rim = b.dataset.rim; resetBelow(st, 'rim');
        const r = findPart(rims, st.rim); const ok = r ? allowedHoles(r.p, pos) : [];
        if (ok.length === 1 || (pos === 'd' && ok.includes(32))) st.holes = pos === 'd' && ok.includes(32) ? 32 : ok[0];
        resetBelow(st, 'holes'); zoom3D('full');
      } else if ('holes' in b.dataset) { st.holes = Number(b.dataset.val); resetBelow(st, 'holes'); }
      else if (b.dataset.hub) {
        st.hub = b.dataset.hub; resetBelow(st, 'hub');
        const hb = findPart(rear, st.hub);
        if (pos === 't' && hb && (hb.p.freehubs || []).length === 1) st.fh = (hb.p.freehubs as string[])[0];
        zoom3D('maza', b, pos === 't');
      } else if ('fh' in b.dataset) { st.fh = b.dataset.val || null; zoom3D('nucleo', b, true); }
      render();
    });

    function quote() {
      if (!configText) { msg(S('builder.incomplete')); return; }
      try { sessionStorage.setItem('715-config', configText); location.href = D.contact; }
      catch { location.href = `${D.contact}&cfg=${encodeURIComponent(configText)}`; }
    }

    // ---- Visor 3D (github.com/Farinabikestore/715-3d) ----
    const A3 = () => (window as any).ARM3D;
    const c3 = (c: string | null) => (c === 'silver' ? 'silver' : 'negro');
    const aro3D = (k: string | null) => { const [id, c] = split(k); if (id === 'e30-ultra') return 'ultra'; if (id === 'enduro-h30') return 'h30-' + c3(c); return null; };
    const mazaT3D = (k: string | null) => { const [id, c] = split(k); return id === 'ultra' || id === 'trail' ? `${id}-${c3(c)}` : null; };
    const mazaD3D = (k: string | null) => 'del-' + c3(split(k)[1]);
    const fh3D = (f: string | null) => (f === 'MS' ? 'ms' : f === 'XD' ? 'xd' : f === 'HG' ? 'hg' : null);
    let rueda3D: 'd' | 't' = 't';
    function update3D() {
      const wt = document.getElementById('arm-wt');
      if (wt) {
        wt.classList.toggle('on', sel.tipo === 'par');
        wt.querySelectorAll<HTMLButtonElement>('button').forEach((b) => b.classList.toggle('sel', b.dataset.w === rueda3D));
      }
      if (!A3()) return;
      const front3 = (st: Wheel) => A3().set({ aro: aro3D(st.rim) || 'h30-negro', maza: mazaD3D(st.hub) });
      const rear3 = (st: Wheel) => A3().set({ aro: aro3D(st.rim) || 'h30-negro', maza: mazaT3D(st.hub) || 'ultra-negro', nucleo: fh3D(st.fh) || 'hg' });
      if (sel.tipo === 'del') front3(sel.one);
      else if (sel.tipo === 'tra') rear3(sel.one);
      else if (rueda3D === 'd') front3(sel.par.d);
      else rear3(sel.par.t);
    }
    document.getElementById('arm-wt')?.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-w]');
      if (!b) return;
      rueda3D = b.dataset.w as 'd' | 't';
      update3D();
    });

    // Zoom automático: al llegar a la maza o al núcleo la cámara se acerca; al elegir, se aleja sola.
    let zonaKey: string | null = null, zonaLock: string | null = null, zoomOutT: ReturnType<typeof setTimeout> | undefined;
    function zoom3D(step: string, srcEl?: HTMLElement, tieneNucleo?: boolean) {
      if (!A3() || !A3().vista) return;
      clearTimeout(zoomOutT);
      if (step === 'maza' || step === 'nucleo') {
        A3().vista('maza');
        const s = srcEl ? srcEl.closest('.arm-step[data-zone]') : null;
        zonaLock = s ? s.getAttribute('data-zk') : null;
        if (step === 'nucleo' || (step === 'maza' && !tieneNucleo)) zoomOutT = setTimeout(() => A3().vista('full'), 4000);
      } else { A3().vista('full'); zonaLock = null; }
    }
    const scroller = document.getElementById('arm-scroll')!;
    function zonaScan() {
      if (!A3() || !A3().vista) return;
      const box = scroller.getBoundingClientRect(), mid = box.top + box.height * 0.45;
      let best: Element | null = null, bestD = 1e9;
      document.querySelectorAll('#arm-steps .arm-step[data-zone]').forEach((el) => {
        const r = el.getBoundingClientRect();
        if (r.height < 10 || r.bottom < box.top + 40 || r.top > box.bottom - 40) return;
        const d = Math.abs((Math.max(r.top, box.top) + Math.min(r.bottom, box.bottom)) / 2 - mid);
        if (d < bestD) { bestD = d; best = el; }
      });
      if (!best) return;
      const el = best as Element, k = el.getAttribute('data-zk');
      if (k === zonaKey) return;
      zonaKey = k;
      if (k === zonaLock) return;
      zonaLock = null; clearTimeout(zoomOutT);
      const w = el.getAttribute('data-zw');
      if (w && sel.tipo === 'par' && w !== rueda3D) { rueda3D = w as 'd' | 't'; update3D(); }
      A3().vista(el.getAttribute('data-zone') === 'maza' ? 'maza' : 'full');
    }
    let zonaT: ReturnType<typeof setTimeout> | null = null;
    scroller.addEventListener('scroll', () => { if (zonaT) return; zonaT = setTimeout(() => { zonaT = null; zonaScan(); }, 130); }, { passive: true });

    function boot3D() {
      (window as any).ARM3D_T = {
        full: S('builder.3d.full'), hub: S('builder.3d.hub'), helpFreehub: S('builder.3d.helpFreehub'), helpSpin: S('builder.3d.helpSpin'),
        engaged: S('builder.3d.engaged'), free: S('builder.3d.free'), pick: S('builder.3d.pick'), error: S('builder.3d.error'),
      };
      const s = document.createElement('script');
      s.src = '/3d/visor715.js';
      s.onload = () => {
        const box = document.getElementById('arm-3d');
        if (box && A3()) { A3().init(box, '/3d/', { zoom: matchMedia('(max-width: 860px)').matches ? 1.12 : 0.95, fov: 14, animMs: 1600, maza: { az: -65, el: -44 } }); update3D(); }
      };
      s.onerror = () => console.warn('[armador] no se pudo cargar el visor 3D');
      document.head.appendChild(s);
    }

    document.getElementById('arm-loading')!.hidden = true;
    document.getElementById('arm-grid')!.hidden = false;
    render();
    boot3D();
  }
</script>

