---
// Dibuja la lista de bloques que se arma (y reordena arrastrando) en el panel.
import Img from './Img.astro';
import ProductCard from './ProductCard.astro';
import { t } from '../i18n/ui.js';
import { getProducts, CATEGORIES, md, link, safeUrl } from '../lib/content.js';
import { variant } from '../lib/img.js';

const { blocks = [], lang, short = false } = Astro.props;
const products = getProducts(lang);
const themeClass = (th) => (th === 'dark' ? 'theme-dark' : th === 'sage' ? 'theme-sage' : 'theme-light');
const ytId = (v) => {
  if (!v) return '';
  const m = String(v).match(/(?:youtu\.be\/|v=|embed\/|shorts\/)([\w-]{11})/);
  return m ? m[1] : /^[\w-]{11}$/.test(v) ? v : '';
};
const catImage = (c) => {
  const p = products.find((x) => x.category === c && x.images.length);
  return p ? p.images[0] : '';
};
const catCount = (c) => products.filter((x) => x.category === c).length;
const vbHeights = { short: 360, normal: 520, tall: 700 };
const vbShades = { light: 0.25, medium: 0.45, strong: 0.6 };
const videoUrl = (v) => { const u = safeUrl(v); return /\.(mp4|webm)(\?.*)?$/i.test(u) && (u.startsWith('/uploads/') || u.startsWith('https://')) ? u : ''; };
const playIcon = '<svg viewBox="0 0 24 24" fill="#161817" aria-hidden="true"><path d="M7 4.5v15l13-7.5z"/></svg>';
---
{blocks.filter(Boolean).map((b, i) => {
  const first = i === 0;
  switch (b.type) {
    case 'hero':
      return (
        <section class:list={['hero', { 'hero--short': short || b.size === 'short' }]}>
          {b.image && (
            <div class="hero__media">
              <Img src={b.image} alt="" sizes="100vw" eager={first} />
            </div>
          )}
          <div class="wrap hero__body">
            {first ? <h1>{b.heading}</h1> : <h2 class="h1">{b.heading}</h2>}
            {b.text && <p>{b.text}</p>}
            {(b.cta_label || b.cta2_label) && (
              <div class="btn-row">
                {b.cta_label && b.cta_link && <a class="btn btn--primary" href={link(b.cta_link, lang)}>{b.cta_label}</a>}
                {b.cta2_label && b.cta2_link && <a class="btn btn--ghost" href={link(b.cta2_link, lang)}>{b.cta2_label}</a>}
              </div>
            )}
          </div>
        </section>
      );

    case 'categories':
      return (
        <section class="block">
          <div class="wrap">
            {b.heading && <div class="block__head"><h2>{b.heading}</h2></div>}
            <div class="cat-grid">
              {CATEGORIES.filter((c) => catCount(c) > 0).map((c) => (
                <a class="cat-tile" href={`/${lang}/products/#${c}`}>
                  <span class="cat-tile__media"><Img src={catImage(c)} alt="" sizes="(max-width: 700px) 42vw, 200px" /></span>
                  <span class="cat-tile__label">{t(lang, `cat.${c}`)} <span>{catCount(c)}</span></span>
                </a>
              ))}
            </div>
          </div>
        </section>
      );

    case 'feature':
      return (
        <section class:list={['block', themeClass(b.theme)]}>
          <div class:list={['wrap', 'feature', { 'feature--img-right': b.image_side === 'right' }]}>
            <div class="feature__media">
              <Img src={b.image} alt="" sizes="(max-width: 820px) 92vw, 50vw" />
            </div>
            <div class="feature__text">
              <h2>{b.heading}</h2>
              <div class="prose" set:html={md(b.text)} />
              {b.cta_label && b.cta_link && (
                <a class:list={['btn', b.theme === 'dark' ? 'btn--primary' : 'btn--dark']} href={link(b.cta_link, lang)}>{b.cta_label}</a>
              )}
            </div>
          </div>
        </section>
      );

    case 'products': {
      let list = b.mode === 'category' && b.category ? products.filter((p) => p.category === b.category) : products.filter((p) => p.featured);
      if (!list.length) list = products;
      list = list.slice(0, Number(b.limit) || 8);
      return (
        <section class="block">
          <div class="wrap">
            <div class="block__head">
              <h2>{b.heading}</h2>
              {b.text && <p>{b.text}</p>}
              <a class="btn btn--ghost" href={`/${lang}/products/`}>{t(lang, 'products.seeAll')}</a>
            </div>
            <div class="product-grid">
              {list.map((p) => <ProductCard product={p} lang={lang} showCategory />)}
            </div>
          </div>
        </section>
      );
    }

    case 'builder_cta':
      return (
        <section class="block theme-dark">
          <div class="wrap band">
            <div>
              <h2>{b.heading}</h2>
              {b.text && <p class="lead">{b.text}</p>}
              <a class="btn btn--primary" href={link(b.cta_link || '/wheel-builder/', lang)}>{b.cta_label || t(lang, 'nav.builder')}</a>
            </div>
            <div class="band__media">
              <Img src={b.image} alt="" sizes="(max-width: 820px) 92vw, 45vw" />
            </div>
          </div>
        </section>
      );

    case 'dealer_cta':
      return (
        <section class="block dealer">
          <div class="wrap">
            <h2>{b.heading}</h2>
            <div>
              {b.text && <p>{b.text}</p>}
              <a class="btn btn--dark" href={link(b.cta_link || '/contact/', lang)}>{b.cta_label || t(lang, 'nav.contact')}</a>
            </div>
          </div>
        </section>
      );

    case 'gallery':
      return (
        <section class="block">
          <div class="wrap">
            {b.heading && <div class="block__head"><h2>{b.heading}</h2></div>}
            <div class="gallery-grid">
              {(b.images || []).map((src) => <Img src={src} alt="" sizes="(max-width: 700px) 92vw, 33vw" />)}
            </div>
          </div>
        </section>
      );

    case 'video_banner': {
      const src = videoUrl(b.video);
      if (!src) return null;
      const mobile = videoUrl(b.video_mobile);
      const h = vbHeights[b.size] || vbHeights.normal;
      const shade = vbShades[b.shade] ?? vbShades.medium;
      return (
        <section class="vbanner" style={`--vb-h:${h}px;--vb-shade:${shade}`} aria-label={b.cta_label || undefined}>
          <video class="vbanner__video" autoplay muted loop playsinline preload="metadata" poster={b.poster ? variant(b.poster, 960) : undefined} aria-hidden="true" data-vbanner>
            {mobile && <source src={mobile} type="video/mp4" media="(max-width: 760px)" />}
            <source src={src} type={src.endsWith('.webm') ? 'video/webm' : 'video/mp4'} />
          </video>
          <div class="vbanner__shade"></div>
          {b.cta_label && <a class="vbanner__btn" href={link(b.cta_link || '/products/', lang)}>{b.cta_label}</a>}
        </section>
      );
    }

    case 'video': {
      const id = ytId(b.youtube);
      if (!id) return null;
      return (
        <section class="block">
          <div class="wrap">
            {b.heading && <div class="block__head"><h2>{b.heading}</h2></div>}
            <button class="video-facade" type="button" data-yt={id} aria-label={b.heading || 'Video'}>
              {b.poster ? <Img src={b.poster} alt="" sizes="100vw" /> : <img src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`} alt="" loading="lazy" />}
              <span class="video-facade__play" set:html={playIcon} />
            </button>
          </div>
        </section>
      );
    }

    case 'text':
      return (
        <section class:list={['block', themeClass(b.theme)]}>
          <div class="wrap">
            {b.heading && <h2 class="block-title">{b.heading}</h2>}
            <div class="prose" set:html={md(b.body)} />
          </div>
        </section>
      );

    default:
      return null;
  }
})}

<script>
  // Los videos de YouTube se cargan solo al hacer clic (la página queda más liviana).
  document.querySelectorAll<HTMLButtonElement>('.video-facade[data-yt]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const f = document.createElement('iframe');
      f.className = 'video-frame';
      f.src = `https://www.youtube-nocookie.com/embed/${btn.dataset.yt}?autoplay=1&rel=0`;
      f.title = btn.getAttribute('aria-label') || 'Video';
      f.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      f.setAttribute('allowfullscreen', '');
      btn.replaceWith(f);
    });
  });
</script>

<script>
  // Videos de fondo: se pausan fuera de pantalla y no se mueven si el visitante pidió reducir el movimiento.
  const vids = document.querySelectorAll<HTMLVideoElement>('video[data-vbanner]');
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  vids.forEach((v) => {
    if (still) { v.removeAttribute('autoplay'); v.pause(); return; }
    if ('IntersectionObserver' in window) {
      new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) v.play().catch(() => {}); else v.pause(); }), { threshold: 0.05 }).observe(v);
    }
  });
</script>
