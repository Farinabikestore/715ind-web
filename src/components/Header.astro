---
import { LOCALES, LANG_NAMES, t } from '../i18n/ui.js';
const { lang, path, settings } = Astro.props;
const items = [
  { href: '/products/', key: 'nav.products' },
  { href: '/wheel-builder/', key: 'nav.builder' },
  { href: '/about/', key: 'nav.about' },
];
const isCurrent = (href) => path === href || (href !== '/' && path.startsWith(href));
const globe = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.7 3.8 5.7 3.8 9s-1.3 6.3-3.8 9c-2.5-2.7-3.8-5.7-3.8-9S9.5 5.7 12 3z"/></svg>';
---
<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="wordmark" href={`/${lang}/`}>
      {settings.logo ? <img src={settings.logo} alt={settings.brand_name} width="120" height="30" /> : settings.brand_name}
    </a>

    <nav class="site-nav" aria-label={t(lang, 'nav.menu')}>
      {items.map((i) => (
        <a href={`/${lang}${i.href}`} aria-current={isCurrent(i.href) ? 'page' : undefined}>{t(lang, i.key)}</a>
      ))}
      <a class="btn btn--primary" href={`/${lang}/contact/`} aria-current={isCurrent('/contact/') ? 'page' : undefined}>{t(lang, 'nav.contact')}</a>
    </nav>

    <details class="lang">
      <summary aria-label={t(lang, 'nav.language')}><Fragment set:html={globe} />{lang.toUpperCase()}</summary>
      <ul>
        {LOCALES.map((l) => (
          <li><a href={`/${l}${path}`} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined}>{LANG_NAMES[l]} <span>{l}</span></a></li>
        ))}
      </ul>
    </details>

    <details class="menu-toggle">
      <summary>{t(lang, 'nav.menu')}</summary>
      <nav aria-label={t(lang, 'nav.menu')}>
        {items.map((i) => (
          <a href={`/${lang}${i.href}`} aria-current={isCurrent(i.href) ? 'page' : undefined}>{t(lang, i.key)}</a>
        ))}
        <a class="btn btn--primary" href={`/${lang}/contact/`}>{t(lang, 'nav.contact')}</a>
      </nav>
    </details>
  </div>
</header>
